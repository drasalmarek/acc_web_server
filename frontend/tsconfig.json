# app.py

from flask import Flask, render_template, request, jsonify
import asyncio
from bleak import BleakClient
import time
import threading

app = Flask(__name__)

SENSOR_ADDR = ["C6:E6:A3:FC:45:F5", "EB:F8:1D:58:73:87", "D2:F3:34:16:59:B1", "CB:71:2E:31:FC:98", "E7:31:E9:B5:72:2A"]

class BLEWorker:
    def __init__(self, address):
        self.address = address
        self.client = None

    async def connect(self):
        self.client = BleakClient(self.address)
        await self.client.connect()

    async def disconnect(self):
        if self.client:
            await self.client.disconnect()

    async def send_command(self, command):
        if self.client and self.client.is_connected:
            await self.client.write_gatt_char(UART_RX_CHAR_UUID, command.encode())

    async def query_command(self, command):
        if self.client and self.client.is_connected:
            await self.client.write_gatt_char(UART_RX_CHAR_UUID, command.encode())
            response = await self.client.read_gatt_char(UART_TX_CHAR_UUID)
            return response.decode()

def periodic_measurement_cycle(worker, period_hours, duration_minutes):
    time.sleep((period_hours * 3600) - 120)  # Wait until 2 minutes before the period
    asyncio.run(worker.connect())
    
    # Send configuration commands
    asyncio.run(worker.send_command("CONF:ADXL ON,400"))
    asyncio.run(worker.send_command("CONF:BNO OFF,100"))
    asyncio.run(worker.send_command("CONF:ADC OFF,10000"))
    
    # Start measurement
    asyncio.run(worker.send_command("MEAS:START"))
    time.sleep(duration_minutes * 60)  # Wait for the duration of the measurement
    asyncio.run(worker.send_command("MEAS:STOP"))
    
    # Download data file and power off
    # (Assuming a function download_data_file exists)
    download_data_file()
    asyncio.run(worker.send_command("POW:OFF"))
    asyncio.run(worker.disconnect())

@app.route('/')
def index():
    return render_template('index.html')

@app.route('/start_measurement', methods=['POST'])
def start_measurement():
    data = request.json
    address = data['address']
    period_hours = data['period_hours']
    duration_minutes = data['duration_minutes']
    
    worker = BLEWorker(address)
    threading.Thread(target=periodic_measurement_cycle, args=(worker, period_hours, duration_minutes)).start()
    
    return jsonify({"status": "Measurement cycle started"})

if __name__ == '__main__':
    app.run(debug=True)